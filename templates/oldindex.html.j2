          <!-- Week Priority Action Callout -->
          <div class="mt-4 px-3.5 py-2.5 rounded-lg bg-slate-950/80 border border-slate-800/90 flex items-center gap-2.5 text-xs sm:text-sm text-slate-200">
            <span class="font-mono text-cyan-400 font-semibold uppercase shrink-0">Week #{{ week.issue_number }} Key Fix:</span>
            <span>{{ week.priority_action }}</span>
          </div>

          <!-- Stacked Week Story Cards -->
          <div id="week-body-{{ week.week_id }}" class="week-stories-container mt-5 grid grid-cols-1 md:grid-cols-3 gap-4">
            {% for item in week['items'] %}
            <article
              class="newsletter-card rounded-xl bg-slate-900/70 border border-slate-800/90 p-4 flex flex-col justify-between"
              data-source="{{ item.source_id }}"
              data-severity="{{ item.severity }}"
              data-search="{{ (item.title ~ ' ' ~ item.summary ~ ' ' ~ item.action_step ~ ' ' ~ item.category ~ ' ' ~ (item.affected_tools | join(' '))) | lower }}"
