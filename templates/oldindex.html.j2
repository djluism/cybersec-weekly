                <div class="flex items-center justify-between text-[11px] font-mono pt-0.5">
                  <span class="text-slate-400 truncate max-w-[65%]">{{ item.affected_tools | join(', ') }}</span>
                  <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300">
                    Read Source →
                  </a>
                </div>
              </div>
            </article>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- AUTOMATION PIPELINE ARCHITECTURE & GITHUB ACTIONS INFO                -->
    <!-- ===================================================================== -->
    <section class="rounded-2xl bg-slate-900/60 border border-slate-800 p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-800">
