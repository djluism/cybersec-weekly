                  {% endif %}

                  <span class="text-[11px] font-mono text-slate-400">{{ item.severity }} • {{ item.time_to_fix }}</span>
                </div>

                <h4 class="text-base font-bold text-white leading-snug">
                  {{ item.title }}
                </h4>

                <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed">
                  {{ item.summary }}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-800/80 space-y-2.5">
                <label for="check-{{ item.id }}" class="action-box flex items-start gap-2.5 p-2.5 rounded-lg bg-obsidian-950/80 border border-slate-800/90 cursor-pointer">
                  <input
                    id="check-{{ item.id }}"
                    type="checkbox"
                    data-action-id="{{ item.id }}"
                    class="action-checkbox mt-0.5 h-3.5 w-3.5 rounded border-slate-600 bg-slate-900 text-emerald-500 cursor-pointer"
