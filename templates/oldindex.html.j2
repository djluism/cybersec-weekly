  <!-- Embedded Newsletter JSON Data for Client-Side Copy & Interactive Filtering -->
  <script id="newsletter-data" type="application/json">{{ site_data_json | safe }}</script>

  <script>
    (function () {
      const STORAGE_KEY = 'smallteam_shield_checked_actions_v1';
      let checkedState = {};
      try {
        checkedState = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      } catch (e) {
        checkedState = {};
      }

      const checkboxes = document.querySelectorAll('.action-checkbox');
      const heroProgressCount = document.getElementById('heroProgressCount');

      function updateProgressUI() {
        let heroTotal = 0;
        let heroDone = 0;
        checkboxes.forEach((cb) => {
          const id = cb.getAttribute('data-action-id');
          const isChecked = Boolean(checkedState[id]);
          cb.checked = isChecked;
          const labelBox = cb.closest('.action-box');
          if (labelBox) {
            labelBox.classList.toggle('action-checked', isChecked);
          }
          if (cb.getAttribute('data-hero-action') === 'true') {
            heroTotal += 1;
            if (isChecked) heroDone += 1;
          }
        });
        if (heroProgressCount) {
          heroProgressCount.textContent = `${heroDone}/${heroTotal}`;
        }
      }

      checkboxes.forEach((cb) => {
        cb.addEventListener('change', (e) => {
          const id = e.target.getAttribute('data-action-id');
          if (e.target.checked) {
            checkedState[id] = true;
          } else {
            delete checkedState[id];
          }
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(checkedState));
          } catch (err) {}
          updateProgressUI();
        });
      });

      updateProgressUI();

      // Filtering by Source, Severity, and Search Query
      let activeSource = 'all';
      const sourceBtns = document.querySelectorAll('.source-filter-btn');
      const searchInput = document.getElementById('searchInput');
      const severityFilter = document.getElementById('severityFilter');
      const cards = document.querySelectorAll('.newsletter-card');

      function applyFilters() {
        const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
        const sev = severityFilter ? severityFilter.value : 'all';

        cards.forEach((card) => {
          const src = card.getAttribute('data-source');
          const cardSev = card.getAttribute('data-severity');
          const haystack = card.getAttribute('data-search') || '';

          const matchSource = activeSource === 'all' || src === activeSource;
          const matchSev =
            sev === 'all' ||
            (sev === 'Critical' && cardSev === 'Critical') ||
            (sev === 'High' && (cardSev === 'Critical' || cardSev === 'High'));
          const matchQuery = !query || haystack.includes(query);

          card.style.display = matchSource && matchSev && matchQuery ? '' : 'none';
        });
      }

      sourceBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeSource = btn.getAttribute('data-source-filter') || 'all';
          sourceBtns.forEach((b) => {
            const isSelected = b.getAttribute('data-source-filter') === activeSource;
            b.className = isSelected
              ? 'source-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 transition cursor-pointer'
              : 'source-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800/70 text-slate-300 border border-slate-700/60 hover:text-white transition cursor-pointer';
          });
          applyFilters();
        });
      });

      if (searchInput) searchInput.addEventListener('input', applyFilters);
      if (severityFilter) severityFilter.addEventListener('change', applyFilters);

      // Expand / Collapse Archive Weeks
      const weekToggleBtns = document.querySelectorAll('.week-toggle-btn');
      function setWeekExpanded(weekId, expanded) {
        const container = document.getElementById(`week-body-${weekId}`);
        const btn = document.querySelector(`[data-toggle-week="${weekId}"]`);
        if (!container || !btn) return;
        container.style.display = expanded ? '' : 'none';
        btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        const label = btn.querySelector('.toggle-label');
        const count = container.querySelectorAll('.newsletter-card').length;
        if (label) {
          label.textContent = expanded ? `Hide ${count} Stories` : `Show ${count} Stories`;
        }
      }

      weekToggleBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const weekId = btn.getAttribute('data-toggle-week');
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';
          setWeekExpanded(weekId, !isExpanded);
        });
      });

      const expandAllBtn = document.getElementById('expandAllWeeksBtn');
      const collapseAllBtn = document.getElementById('collapseAllWeeksBtn');
      if (expandAllBtn) {
        expandAllBtn.addEventListener('click', () => {
          weekToggleBtns.forEach((btn) => setWeekExpanded(btn.getAttribute('data-toggle-week'), true));
        });
      }
      if (collapseAllBtn) {
        collapseAllBtn.addEventListener('click', () => {
          weekToggleBtns.forEach((btn) => setWeekExpanded(btn.getAttribute('data-toggle-week'), false));
        });
      }

      // Copy Current Week Team Summary to Clipboard
      const copyBtn = document.getElementById('copyTeamBriefBtn');
      const copyLabel = document.getElementById('copyTeamBriefLabel');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          try {
            const rawData = JSON.parse(document.getElementById('newsletter-data').textContent);
            const current = rawData.weeks[0];
            const lines = [
              `🛡️ Gaga Security Intel — Weekly Cyber Brief (${current.date_range})`,
              `Priority Action: ${current.priority_action}`,
              ''
            ];
            current.items.forEach((item, idx) => {
              lines.push(`${idx + 1}. [${item.source_name}] ${item.title} (${item.time_to_fix})`);
              lines.push(`   ${item.summary}`);
              lines.push(`   👉 To Do: ${item.action_step}`);
              lines.push('');
            });
            await navigator.clipboard.writeText(lines.join('\n'));
            if (copyLabel) {
              const original = copyLabel.textContent;
              copyLabel.textContent = 'Copied Team Brief to Clipboard!';
              setTimeout(() => {
                copyLabel.textContent = original;
              }, 2500);
            }
          } catch (e) {}
        });
      }
    })();
  </script>
