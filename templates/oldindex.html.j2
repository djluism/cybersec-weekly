                  {% elif item.source_id == 'krebs' %}
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30">Krebs on Security</span>
                  {% else %}
