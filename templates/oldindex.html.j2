        </div>

      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- OLDER WEEKS CHRONOLOGICAL ARCHIVE STACK                               -->
    <!-- ===================================================================== -->
    <section id="older-weeks-archive" aria-labelledby="archive-heading" class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-800 pb-4">
        <div>
          <div class="text-xs font-mono uppercase tracking-widest text-cyan-400">
            Chronological Weekly Stack
          </div>
          <h2 id="archive-heading" class="text-2xl font-bold text-white mt-1">
            Previous Weekly Editions
          </h2>
          <p class="text-sm text-slate-400 mt-1">
            Older weeks stack chronologically below the current Hero Week so new hires or busy founders can catch up in minutes.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button id="expandAllWeeksBtn" type="button" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-mono text-slate-300 cursor-pointer transition">
            Expand All Weeks
          </button>
          <button id="collapseAllWeeksBtn" type="button" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-mono text-slate-300 cursor-pointer transition">
            Collapse All
          </button>
        </div>
      </div>

      <!-- Quick Issue Jump Pills -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-slate-400 mr-1">Jump to edition:</span>
        {% for week in older_weeks %}
        <a href="#week-{{ week.week_id }}" class="px-3 py-1 rounded-full bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 text-xs font-mono text-slate-300 transition">
          Issue #{{ week.issue_number }} • {{ week.date_range }}
        </a>
        {% endfor %}
      </div>

      <!-- Stacked Chronological Container -->
      <div class="relative pl-4 sm:pl-8 border-l-2 border-slate-800 space-y-8">
        {% for week in older_weeks %}
        <div id="week-{{ week.week_id }}" class="archive-week-block relative rounded-2xl bg-obsidian-900/90 border border-slate-800/90 p-5 sm:p-6 transition">
          <!-- Timeline Node Dot -->
          <span class="absolute -left-[25px] sm:-left-[41px] top-7 w-4 h-4 rounded-full bg-obsidian-950 border-2 border-cyan-400"></span>

          <!-- Week Header (Clickable Toggle) -->
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-200 font-mono text-xs font-semibold">
                  ISSUE #{{ week.issue_number }} • {{ week.week_id }}
                </span>
                <span class="text-xs font-mono text-slate-400">
                  {{ week.date_label }} ({{ week.date_range }})
                </span>
                <span class="px-2 py-0.5 rounded bg-slate-800/70 text-slate-300 font-mono text-xs">
                  {{ week.stats.enterprise_noise_filtered }} enterprise alerts filtered out
                </span>
              </div>
              <h3 class="text-xl font-bold text-white">
                {{ week.headline }}
              </h3>
              <p class="text-sm text-slate-300 max-w-3xl">
                {{ week.executive_brief }}
              </p>
            </div>

            <button
              type="button"
              data-toggle-week="{{ week.week_id }}"
              aria-expanded="true"
              class="week-toggle-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-800 border border-slate-700 text-xs font-mono text-slate-200 shrink-0 cursor-pointer"
            >
              <span class="toggle-label">Hide {{ week['items'] | length }} Stories</span>
              <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
